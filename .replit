modules = ["nodejs-20", "web"]
[agent]
expertMode = true
[nix]
channel = "stable-25_05"
packages = ["nano"]
[workflows]
runButton = "Project"
[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"
[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"
[[workflows.workflow]]
name = "Start application"
author = "agent"
[workflows.workflow.metadata]
outputType = "webview"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"
[userenv]
[userenv.shared]
JWT_SECRET = "smartinvest_secret_key_change_me_in_production"
INIT_SECRET = "smartinvest_init_secret"
CRON_SECRET = "smartinvest_cron_secret"
FRONTEND_URL = "https://your-app.replit.app"
